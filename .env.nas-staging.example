# Copy this file to .env in a dedicated staging checkout, replace all secrets,
# and keep this project name unique from every other compose installation.
COMPOSE_PROJECT_NAME=fiscalhot-staging

# NAS Staging only: public page origin and both sides of the Web port mapping.
SITE_URL=http://192.168.3.100:3221
PORT=3221
WEB_PORT=3221
POSTGRES_DB=fiscalhot_staging
# Keep this URL-safe (letters/numbers only): Compose inserts it into DATABASE_URL.
POSTGRES_PASSWORD=
DEPLOY_SHA=
STAGING_NOINDEX=true

# Required unique staging credentials. Generate long random values before use.
ADMIN_PASSWORD=
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# No external model/provider keys are required in the initial staging phase.
LLM_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
XIAOMI_MIMO_API_KEY=
EMBEDDING_API_KEY=
SOCIALDATA_API_KEY=
DAJIALA_KEY=
JINA_API_KEY=
FEISHU_APP_SECRET=
FEISHU_CONTENT_PUSH_ENABLED=false
FEISHU_INTERNAL_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false
JINA_BODY_FALLBACK=false
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
OCR_RUN_ENABLED=false
ALLOW_PRIVATE_NETWORK_FETCH=false
TRUST_PROXY=false
LOCAL_PREVIEW_ENABLED=false
LOCAL_PREVIEW_LAN_ENABLED=false

# The staging instance is directly exposed on the LAN; keep all credentials local.
EGRESS_PROXY_URL=
